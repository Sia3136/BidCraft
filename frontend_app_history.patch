diff --git a/frontend/app/api/revalidate/route.ts b/frontend/app/api/revalidate/route.ts
new file mode 100644
index 00000000..a449c72e
--- /dev/null
+++ b/frontend/app/api/revalidate/route.ts
@@ -0,0 +1,24 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { revalidatePath, revalidateTag } from 'next/cache';
+
+export async function POST(req: NextRequest) {
+  try {
+    const { paths = [], tags = [] } = await req.json();
+
+    if (paths.length > 0) {
+      for (const path of paths) {
+        revalidatePath(path);
+      }
+    }
+    
+    if (tags.length > 0) {
+      for (const tag of tags) {
+        revalidateTag(tag);
+      }
+    }
+
+    return NextResponse.json({ success: true, revalidatedPaths: paths, revalidatedTags: tags });
+  } catch (error) {
+    return NextResponse.json({ success: false, error: 'Invalid request' }, { status: 400 });
+  }
+}
