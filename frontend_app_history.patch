+  /* Soft sand secondary */
+  --secondary: oklch(0.93 0.018 80);
+  --secondary-foreground: oklch(0.32 0.03 55);
+
+  --muted: oklch(0.93 0.015 82);
+  --muted-foreground: oklch(0.48 0.02 60);
+
+  /* Forest green accent */
+  --accent: oklch(0.42 0.07 150);
+  --accent-foreground: oklch(0.97 0.01 85);
+
+  --destructive: oklch(0.55 0.2 28);
+
+  --border: oklch(0.89 0.014 80);
+  --input: oklch(0.89 0.014 80);
+  --ring: oklch(0.58 0.13 40);
+
+  --chart-1: oklch(0.58 0.13 40);
+  --chart-2: oklch(0.42 0.07 150);
+  --chart-3: oklch(0.7 0.08 70);
+  --chart-4: oklch(0.55 0.05 120);
+  --chart-5: oklch(0.45 0.04 50);
+
+  --sidebar: oklch(0.988 0.008 85);
+  --sidebar-foreground: oklch(0.27 0.02 60);
+  --sidebar-primary: oklch(0.58 0.13 40);
+  --sidebar-primary-foreground: oklch(0.98 0.01 85);
+  --sidebar-accent: oklch(0.93 0.018 80);
+  --sidebar-accent-foreground: oklch(0.32 0.03 55);
+  --sidebar-border: oklch(0.89 0.014 80);
+  --sidebar-ring: oklch(0.58 0.13 40);
+}
+
+.dark {
+  color-scheme: dark;
+  --background: oklch(0.22 0.012 60);
+  --foreground: oklch(0.94 0.01 85);
+  --card: oklch(0.26 0.014 60);
+  --card-foreground: oklch(0.94 0.01 85);
+  --popover: oklch(0.26 0.014 60);
+  --popover-foreground: oklch(0.94 0.01 85);
+  --primary: oklch(0.65 0.13 42);
+  --primary-foreground: oklch(0.18 0.01 60);
+  --secondary: oklch(0.32 0.02 60);
+  --secondary-foreground: oklch(0.94 0.01 85);
+  --muted: oklch(0.32 0.02 60);
+  --muted-foreground: oklch(0.72 0.015 70);
+  --accent: oklch(0.55 0.09 150);
+  --accent-foreground: oklch(0.97 0.01 85);
+  --destructive: oklch(0.7 0.19 22);
+  --border: oklch(1 0 0 / 12%);
+  --input: oklch(1 0 0 / 15%);
+  --ring: oklch(0.65 0.13 42);
+  --chart-1: oklch(0.65 0.13 42);
+  --chart-2: oklch(0.55 0.09 150);
+  --chart-3: oklch(0.7 0.08 70);
+  --chart-4: oklch(0.55 0.05 120);
+  --chart-5: oklch(0.45 0.04 50);
+  --sidebar: oklch(0.26 0.014 60);
+  --sidebar-foreground: oklch(0.94 0.01 85);
+  --sidebar-primary: oklch(0.65 0.13 42);
+  --sidebar-primary-foreground: oklch(0.18 0.01 60);
+  --sidebar-accent: oklch(0.32 0.02 60);
+  --sidebar-accent-foreground: oklch(0.94 0.01 85);
+  --sidebar-border: oklch(1 0 0 / 12%);
+  --sidebar-ring: oklch(0.65 0.13 42);
+}
+
+@keyframes heroPan {
+  0% {
+    transform: scale(1.08) translateX(0);
+  }
+  100% {
+    transform: scale(1.12) translateX(-2.5%);
+  }
+}
+
+@layer base {
+  * {
+    @apply border-border outline-ring/50;
+  }
+  body {
+    @apply bg-background text-foreground;
+  }
+  html {
+    @apply font-sans;
+  }
+}
