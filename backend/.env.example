# --------------------------------------------------
# Backend Environment Variables (.env)
# --------------------------------------------------

# Server
PORT=8000
# PRODUCTION: Must be the explicit production frontend URL
# LOCAL: Defaults to http://localhost:3000 if not set
FRONTEND_ORIGIN=http://localhost:3000

# --------------------------------------------------
# Mode 1: Local Docker Development (`docker compose --profile local up`)
# Uncomment these to use the local Postgres and Redis containers.
# --------------------------------------------------
# DATABASE_URL=postgresql://bidcraft_user:bidcraft_password@db:5432/bidcraft_db
# REDIS_URL=redis://redis:6379

# --------------------------------------------------
# Mode 2: Cloud Production/Development (`docker compose --profile cloud up`)
# Uncomment these to use Neon and Upstash.
# --------------------------------------------------
DATABASE_URL=your_postgres_database_url
REDIS_URL=your_redis_url
UPSTASH_REDIS_REST_URL=https://your-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# --------------------------------------------------
# Auth
# --------------------------------------------------
JWT_SECRET=your_jwt_secret

# --------------------------------------------------
# Cloudinary
# --------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------------------------------------------
# Google
# --------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --------------------------------------------------
# Razorpay
# --------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --------------------------------------------------
# KYC Sandbox
# --------------------------------------------------
KYC_SANDBOX_KEY=your_kyc_sandbox_key
KYC_SANDBOX_SECRET=your_kyc_sandbox_secret

# --------------------------------------------------
# Delivery
# --------------------------------------------------
DELIVERY_API_KEY=your_delivery_api_key

# --------------------------------------------------
# SMTP
# --------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# --------------------------------------------------
# Resend
# --------------------------------------------------
RESEND_API_KEY=your_resend_api_key

CRON_SECRET=your_cron_secret

# --------------------------------------------------
# Development Mode Settings
# --------------------------------------------------
# Set to 'true' ONLY in local development to enable mock services 
# (e.g., bypass OTP, Mock Razorpay Signature, Mock KYC).
USE_MOCKS=false
