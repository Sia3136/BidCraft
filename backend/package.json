{
  "name": "bidcraft-backend",
  "version": "0.1.0",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "migrate:status": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up --dry-run",
    "test": "node -r dotenv/config node_modules/jest/bin/jest.js --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^6.0.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.4.1",
    "pg": "^8.11.0",
    "razorpay": "^2.9.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "node-pg-migrate": "^7.9.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
