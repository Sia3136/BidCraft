+                        className="absolute top-2 right-2 w-8 h-8 bg-white text-[var(--color-urgent-600)] rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
+                      >
+                        <X className="w-4 h-4" />
+                      </button>
+                    )}
+                  </div>
+                ))}
+              </div>
+            )}
+          </div>
+        )}
+
+        {step === 3 && (
