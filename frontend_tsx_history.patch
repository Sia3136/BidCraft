+
+  return (
+    <main className="min-h-screen bg-background">
+      <Navbar />
+
+      {/* Hero Banner Header */}
+      <div className="h-60 bg-gradient-to-r from-violet-600 via-indigo-600 to-primary relative shadow-inner">
