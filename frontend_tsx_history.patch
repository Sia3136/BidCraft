+++ b/frontend/components/pdp/ImageGallery.tsx
@@ -0,0 +1,242 @@
+'use client'
+
+import React, { useState, useRef, useEffect, useCallback } from 'react'
+import Image from 'next/image'
+import { X, ChevronLeft, ChevronRight } from 'lucide-react'
+import { cn } from '@/lib/utils'
+
+interface ImageGalleryProps {
+  images: string[]
+  alt: string
+}
+
+export function ImageGallery({ images, alt }: ImageGalleryProps) {
+  // Normalise: always work with an array, filter out empties
+  const imgs = (Array.isArray(images) ? images : images ? [images] : []).filter(Boolean)
+  if (imgs.length === 0) imgs.push('/placeholder.jpg')
+
+  const [activeIdx, setActiveIdx] = useState(0)
+  const [lightboxOpen, setLightboxOpen] = useState(false)
+  const [lightboxIdx, setLightboxIdx] = useState(0)
+
+  // Touch / swipe state (mobile main image)
+  const touchStartX = useRef<number | null>(null)
+  const containerRef = useRef<HTMLDivElement>(null)
+
+  // ΓöÇΓöÇΓöÇ Keyboard navigation for lightbox ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+  useEffect(() => {
+    if (!lightboxOpen) return
+    const handler = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') setLightboxOpen(false)
+      if (e.key === 'ArrowRight') setLightboxIdx(i => (i + 1) % imgs.length)
+      if (e.key === 'ArrowLeft') setLightboxIdx(i => (i - 1 + imgs.length) % imgs.length)
+    }
+    window.addEventListener('keydown', handler)
+    return () => window.removeEventListener('keydown', handler)
+  }, [lightboxOpen, imgs.length])
+
+  // Lock body scroll when lightbox is open
+  useEffect(() => {
+    if (lightboxOpen) {
+      document.body.style.overflow = 'hidden'
+    } else {
+      document.body.style.overflow = ''
+    }
+    return () => { document.body.style.overflow = '' }
+  }, [lightboxOpen])
+
+  // ΓöÇΓöÇΓöÇ Touch handlers (mobile swipe on main image) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
+  const onTouchStart = (e: React.TouchEvent) => {
+    touchStartX.current = e.touches[0].clientX
+  }
+
+  const onTouchEnd = (e: React.TouchEvent) => {
+    if (touchStartX.current === null) return
+    const deltaX = e.changedTouches[0].clientX - touchStartX.current
+    touchStartX.current = null
+    if (Math.abs(deltaX) < 40) return // too small, ignore
+    if (deltaX < 0) {
+      // swipe left ΓåÆ next
+      setActiveIdx(i => (i + 1) % imgs.length)
+    } else {
+      // swipe right ΓåÆ prev
+      setActiveIdx(i => (i - 1 + imgs.length) % imgs.length)
+    }
+  }
+
+  const openLightbox = useCallback((idx: number) => {
+    setLightboxIdx(idx)
+    setLightboxOpen(true)
+  }, [])
+
+  const hasMultiple = imgs.length > 1
+
+  return (
+    <>
+      {/* ΓöÇΓöÇΓöÇ Main Gallery ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}
+      <div className="flex flex-col md:flex-row-reverse gap-4 sticky top-24">
+
+        {/* Main image */}
+        <div
+          ref={containerRef}
+          className="relative aspect-square md:aspect-[4/3] lg:aspect-[4/4] bg-[var(--color-cream-deep)] rounded-[var(--radius-lg)] overflow-hidden flex-1 cursor-zoom-in"
+          onTouchStart={hasMultiple ? onTouchStart : undefined}
+          onTouchEnd={hasMultiple ? onTouchEnd : undefined}
+          onClick={() => openLightbox(activeIdx)}
+          role="button"
+          aria-label={`View ${alt} ΓÇö image ${activeIdx + 1} of ${imgs.length} in full screen`}
+          tabIndex={0}
+          onKeyDown={e => { if (e.key === 'Enter') openLightbox(activeIdx) }}
+        >
+          <Image
+            src={imgs[activeIdx]}
+            fill
+            sizes="(max-width: 768px) 100vw, 60vw"
+            style={{
+              objectFit: 'cover',
+              // GPU-accelerated zoom on hover via CSS class below
+              transition: 'transform 0.32s ease',
+            }}
+            alt={alt}
+            priority={activeIdx === 0}
+            className="gallery-main-img"
+            onError={e => { e.currentTarget.src = '/placeholder.jpg' }}
+          />
+          {/* Zoom hint overlay (desktop only) ΓÇö appears on hover */}
+          <div
+            aria-hidden
+            className="absolute inset-0 hidden md:flex items-end justify-end p-3 pointer-events-none"
+          >
+            <span className="text-[10px] text-white/70 bg-black/30 px-2 py-0.5 rounded-full backdrop-blur-sm">
+              Click to zoom
+            </span>
+          </div>
+        </div>
+
+        {/* Thumbnails ΓÇö desktop only (md+). On mobile, dots are shown instead. */}
+        {hasMultiple && (
+          <div className="hidden md:flex md:flex-col gap-2 overflow-y-auto md:overflow-x-hidden w-[88px] shrink-0 hide-scrollbar max-h-[440px]">
+            {imgs.map((src, idx) => (
+              <button
+                key={idx}
+                onClick={() => setActiveIdx(idx)}
+                aria-label={`View image ${idx + 1}`}
+                className={cn(
+                  'relative w-full h-[88px] rounded-[var(--radius-sm)] overflow-hidden shrink-0 border-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B06A42]',
+                  activeIdx === idx
+                    ? 'border-[#B06A42]'
+                    : 'border-transparent hover:border-[var(--color-ink-300)]'
+                )}
+              >
+                <Image
+                  src={src}
+                  fill
+                  sizes="88px"
+                  style={{ objectFit: 'cover' }}
+                  alt={`Thumbnail ${idx + 1}`}
+                  loading="lazy"
+                  onError={e => { e.currentTarget.src = '/placeholder.jpg' }}
+                />
+              </button>
+            ))}
+          </div>
+        )}
+
+        {/* Dot indicators ΓÇö mobile only */}
+        {hasMultiple && (
+          <div className="flex md:hidden justify-center gap-[6px] pt-1" aria-label="Image gallery position">
+            {imgs.map((_, idx) => (
+              <button
+                key={idx}
+                onClick={() => setActiveIdx(idx)}
+                aria-label={`Go to image ${idx + 1}`}
+                className={cn(
+                  'w-[6px] h-[6px] rounded-full transition-colors focus:outline-none',
+                  activeIdx === idx ? 'bg-[#B06A42]' : 'bg-[#D8C8BA]'
+                )}
+              />
+            ))}
+          </div>
+        )}
+      </div>
+
+      {/* ΓöÇΓöÇΓöÇ Hover zoom CSS (injected via style tag) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}
+      <style jsx global>{`
+        .gallery-main-img {
+          transform: scale(1);
+          will-change: transform;
