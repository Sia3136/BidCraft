+  const { isAuthenticated, token } = useAuthStore()
+  const router = useRouter()
+  const [orders, setOrders] = useState<any[]>([])
+  const [loading, setLoading] = useState(true)
+
+  useEffect(() => {
+    if (!isAuthenticated) {
+      router.push('/auth?returnTo=/orders')
+      return
+    }
