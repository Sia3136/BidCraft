# --------------------------------------------------
# Frontend Environment Variables (.env.example)
# --------------------------------------------------

# Cloudinary (Client-Side - Requires NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upstash Redis (Server-Side)
UPSTASH_REDIS_REST_URL=https://your-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# API Configuration
# NEXT_PUBLIC_API_URL is baked into the Next.js client-side code at build time.
# In local development: http://localhost:8000
# In production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# INTERNAL_API_URL is used for server-side fetches inside Docker containers.
# Usually injected via docker-compose (e.g. http://backend:8000)
# INTERNAL_API_URL=http://backend:8000
