generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auctions {
  id                Int             @id @default(autoincrement())
  listing_id        Int             @unique
  seller_id         Int
  start_bid         Decimal         @db.Decimal(12, 2)
  current_bid       Decimal?        @db.Decimal(12, 2)
  reserve_price     Decimal?        @db.Decimal(12, 2)
  min_bid_increment Decimal?        @default(10.00) @db.Decimal(12, 2)
  start_time        DateTime        @db.Timestamptz(6)
  end_time          DateTime        @db.Timestamptz(6)
  status            auction_status? @default(active)
  total_bids        Int?            @default(0)
  created_at        DateTime?       @default(now()) @db.Timestamp(6)
  updated_at        DateTime?       @default(now()) @db.Timestamp(6)
  listings          listings        @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users           @relation(fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bids              bids[]
  orders            orders?

  @@index([end_time], map: "idx_auctions_end_time")
  @@index([seller_id], map: "idx_auctions_seller_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bids {
  id         Int       @id @default(autoincrement())
  auction_id Int
  bidder_id  Int
  bid_amount Decimal   @db.Decimal(12, 2)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  auctions   auctions  @relation(fields: [auction_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [bidder_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders     orders[]

  @@index([auction_id, bid_amount(sort: Desc)], map: "idx_bids_auction_id_amount")
  @@index([bidder_id], map: "idx_bids_bidder_id")
}

model cart_items {
  id         Int       @id @default(autoincrement())
  user_id    Int
  listing_id Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  listings   listings  @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, listing_id])
}

model categories {
  id               Int          @id @default(autoincrement())
  name             String       @unique @db.VarChar(100)
  slug             String       @unique @db.VarChar(100)
  parent_id        Int?
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")
  listings         listings[]
}

model disputes {
  id                                 Int             @id @default(autoincrement())
  escrow_id                          Int
  initiator_id                       Int
  reason                             String?
  evidence_urls                      Json?
  status                             dispute_status? @default(open)
  resolution                         String?         @db.VarChar(30)
  resolved_by                        Int?
  resolved_at                        DateTime?       @db.Timestamp(6)
  created_at                         DateTime?       @default(now()) @db.Timestamp(6)
  order_id                           Int?
  updated_at                         DateTime?       @default(now()) @db.Timestamp(6)
  escrow                             escrow          @relation(fields: [escrow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_disputes_initiator_idTousers users           @relation("disputes_initiator_idTousers", fields: [initiator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                             orders?         @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  users_disputes_resolved_byTousers  users?          @relation("disputes_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_disputes_order_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model escrow {
  id                            Int                @id @default(autoincrement())
  order_id                      Int                @unique
  status                        escrow_status?     @default(pending)
  buyer_id                      Int
  seller_id                     Int
  amount_held                   Decimal            @db.Decimal(12, 2)
  timeout_at                    DateTime?          @db.Timestamp(6)
  released_at                   DateTime?          @db.Timestamp(6)
  created_at                    DateTime?          @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?          @default(now()) @db.Timestamp(6)
  disputes                      disputes[]
  users_escrow_buyer_idTousers  users              @relation("escrow_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                        orders             @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_escrow_seller_idTousers users              @relation("escrow_seller_idTousers", fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  escrow_audit_log              escrow_audit_log[]
}

model escrow_audit_log {
  id         Int       @id @default(autoincrement())
  escrow_id  Int
  old_status String?   @db.VarChar(30)
  new_status String    @db.VarChar(30)
  actor_id   Int?
  reason     String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  escrow     escrow    @relation(fields: [escrow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model follows {
  id                               Int       @id @default(autoincrement())
  follower_id                      Int
  seller_id                        Int
  created_at                       DateTime? @default(now()) @db.Timestamp(6)
  users_follows_follower_idTousers users     @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_follows_seller_idTousers   users     @relation("follows_seller_idTousers", fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([follower_id, seller_id])
}

model listing_questions {
  id                                         Int       @id @default(autoincrement())
  listing_id                                 Int
  asker_id                                   Int
  question                                   String
  answer                                     String?
  answered_by                                Int?
  is_public                                  Boolean?  @default(true)
  created_at                                 DateTime? @default(now()) @db.Timestamp(6)
  updated_at                                 DateTime? @default(now()) @db.Timestamp(6)
  answered_at                                DateTime? @db.Timestamp(6)
  users_listing_questions_answered_byTousers users?    @relation("listing_questions_answered_byTousers", fields: [answered_by], references: [id], onUpdate: NoAction)
  users_listing_questions_asker_idTousers    users     @relation("listing_questions_asker_idTousers", fields: [asker_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  listings                                   listings  @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([listing_id], map: "idx_listing_questions_listing_id")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model listings {
  id                Int                 @id @default(autoincrement())
  seller_id         Int
  title             String              @db.VarChar(250)
  description       String?
  category          String?             @db.VarChar(100)
  category_id       Int?
  condition         String?             @db.VarChar(40)
  photos            Json
  listing_type      String              @db.VarChar(20)
  price             Decimal?            @db.Decimal(12, 2)
  status            listing_status?     @default(active)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  auctions          auctions?
  cart_items        cart_items[]
  listing_questions listing_questions[]
  categories        categories?         @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  users             users               @relation(fields: [seller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders            orders[]
  reports           reports[]
  wishlist          wishlist[]

  @@index([category], map: "idx_listings_category")
  @@index([category_id], map: "idx_listings_category_id")
  @@index([seller_id], map: "idx_listings_seller_id")
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(255)
  message    String
  data       Json?     @default("{}")
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read, created_at(sort: Desc)], map: "idx_notifications_user_feed")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                            Int           @id @default(autoincrement())
  buyer_id                      Int
  seller_id                     Int
  listing_id                    Int?
  auction_id                    Int?          @unique(map: "orders_auction_id_unique")
  total_amount                  Decimal       @db.Decimal(12, 2)
  status                        order_status? @default(pending)
  created_at                    DateTime?     @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?     @default(now()) @db.Timestamp(6)
  winner_bid_id                 Int?
  shipping_address              Json?
  disputes                      disputes[]
  escrow                        escrow?
  auctions                      auctions?     @relation(fields: [auction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_orders_buyer_idTousers  users         @relation("orders_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  listings                      listings?     @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_orders_seller_idTousers users         @relation("orders_seller_idTousers", fields: [seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bids                          bids?         @relation(fields: [winner_bid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments                      payments[]
  reviews                       reviews[]
  shipments                     shipments[]

  @@index([auction_id], map: "idx_orders_auction_id")
  @@index([buyer_id], map: "idx_orders_buyer_id")
  @@index([seller_id], map: "idx_orders_seller_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id                      Int             @id @default(autoincrement())
  order_id                Int
  amount                  Decimal         @db.Decimal(12, 2)
  payment_provider        String          @db.VarChar(100)
  provider_transaction_id String?         @db.VarChar(200)
  razorpay_order_id       String?         @db.VarChar(200)
  razorpay_payment_id     String?         @db.VarChar(200)
  status                  payment_status?
  method                  String?         @db.VarChar(50)
  created_at              DateTime?       @default(now()) @db.Timestamp(6)
  updated_at              DateTime?       @default(now()) @db.Timestamp(6)
  provider_order_id       String?         @db.VarChar(200)
  orders                  orders          @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_payments_order_id")
}

model pgmigrations {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  run_on DateTime @db.Timestamp(6)
}

model profiles {
  id                   Int       @id @default(autoincrement())
  user_id              Int       @unique
  social_links         Json?
  is_verified          Boolean?  @default(false)
  trust_score          Decimal?  @default(0) @db.Decimal(3, 2)
  total_sales          Int?      @default(0)
  total_revenue        Decimal?  @default(0) @db.Decimal(12, 2)
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)
  bio                  String?
  phone                String?   @db.VarChar(30)
  razorpay_account_id  String?   @db.VarChar(100)
  razorpay_customer_id String?   @db.VarChar(100)
  razorpay_card_token  String?   @db.VarChar(200)
  kyc_status           String?   @default("none") @db.VarChar(30)
  kyc_document_type    String?   @db.VarChar(50)
  kyc_document_url     String?   @db.VarChar(500)
  kyc_rejection_reason String?
  pan_number           String?   @db.VarChar(50)
  bank_account_number  String?   @db.VarChar(100)
  bank_ifsc            String?   @db.VarChar(50)
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model refresh_tokens {
  token      String   @id @db.VarChar(255)
  user_id    Int
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model reports {
  id                                    Int            @id @default(autoincrement())
  reporter_id                           Int
  reported_user_id                      Int?
  reported_listing_id                   Int?
  reason                                String
  status                                report_status? @default(pending)
  created_at                            DateTime       @default(now()) @db.Timestamp(6)
  updated_at                            DateTime       @default(now()) @db.Timestamp(6)
  listings                              listings?      @relation(fields: [reported_listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_reports_reported_user_idTousers users?         @relation("reports_reported_user_idTousers", fields: [reported_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_reports_reporter_idTousers      users          @relation("reports_reporter_idTousers", fields: [reporter_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id                               Int       @id @default(autoincrement())
  order_id                         Int
  reviewer_id                      Int
  reviewee_id                      Int
  rating                           Int
  comment                          String?
  created_at                       DateTime? @default(now()) @db.Timestamp(6)
  orders                           orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_reviews_reviewee_idTousers users     @relation("reviews_reviewee_idTousers", fields: [reviewee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_reviews_reviewer_idTousers users     @relation("reviews_reviewer_idTousers", fields: [reviewer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([order_id, reviewer_id], map: "reviews_order_reviewer_unique")
}

model shipments {
  id              Int       @id @default(autoincrement())
  order_id        Int
  tracking_number String?   @db.VarChar(200)
  carrier         String?   @db.VarChar(100)
  shipped_at      DateTime? @db.Timestamp(6)
  delivered_at    DateTime? @db.Timestamp(6)
  status          String?   @db.VarChar(30)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  orders          orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                                     Int                  @id @default(autoincrement())
  email                                                  String               @unique @db.VarChar(255)
  password_hash                                          String?              @db.VarChar(255)
  google_id                                              String?              @unique @db.VarChar(255)
  name                                                   String?              @db.VarChar(200)
  avatar_url                                             String?              @db.VarChar(500)
  role                                                   String?              @default("buyer") @db.VarChar(20)
  created_at                                             DateTime?            @default(now()) @db.Timestamp(6)
  updated_at                                             DateTime?            @default(now()) @db.Timestamp(6)
  auctions                                               auctions[]
  bids                                                   bids[]
  cart_items                                             cart_items[]
  disputes_disputes_initiator_idTousers                  disputes[]           @relation("disputes_initiator_idTousers")
  disputes_disputes_resolved_byTousers                   disputes[]           @relation("disputes_resolved_byTousers")
  escrow_escrow_buyer_idTousers                          escrow[]             @relation("escrow_buyer_idTousers")
  escrow_escrow_seller_idTousers                         escrow[]             @relation("escrow_seller_idTousers")
  escrow_audit_log                                       escrow_audit_log[]
  follows_follows_follower_idTousers                     follows[]            @relation("follows_follower_idTousers")
  follows_follows_seller_idTousers                       follows[]            @relation("follows_seller_idTousers")
  listing_questions_listing_questions_answered_byTousers listing_questions[]  @relation("listing_questions_answered_byTousers")
  listing_questions_listing_questions_asker_idTousers    listing_questions[]  @relation("listing_questions_asker_idTousers")
  listings                                               listings[]
  notifications                                          notifications[]
  orders_orders_buyer_idTousers                          orders[]             @relation("orders_buyer_idTousers")
  orders_orders_seller_idTousers                         orders[]             @relation("orders_seller_idTousers")
  profiles                                               profiles?
  refresh_tokens                                         refresh_tokens[]
  reports_reports_reported_user_idTousers                reports[]            @relation("reports_reported_user_idTousers")
  reports_reports_reporter_idTousers                     reports[]            @relation("reports_reporter_idTousers")
  reviews_reviews_reviewee_idTousers                     reviews[]            @relation("reviews_reviewee_idTousers")
  reviews_reviews_reviewer_idTousers                     reviews[]            @relation("reviews_reviewer_idTousers")
  verification_codes                                     verification_codes[]
  wishlist                                               wishlist[]
}

model verification_codes {
  id         Int      @id @default(autoincrement())
  user_id    Int
  code       String   @db.VarChar(10)
  purpose    String?  @default("email_verification") @db.VarChar(50)
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model wishlist {
  id         Int       @id @default(autoincrement())
  user_id    Int
  listing_id Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  listings   listings  @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, listing_id])
}

enum auction_status {
  scheduled
  active
  ended
  cancelled
  closed
}

enum dispute_status {
  open
  under_review
  review
  resolved
  dismissed
}

enum escrow_status {
  pending
  held
  released
  cancelled
  paid
  shipped
  delivered
  inspection
  refunded
  disputed
}

enum listing_status {
  active
  paused
  sold
  archived
}

enum order_status {
  pending
  awaiting_payment
  paid
  shipped
  delivered
  inspection
  completed
  cancelled
  refunded
}

enum payment_status {
  pending
  paid
  failed
  refunded
}

enum report_status {
  pending
  reviewed
  dismissed
  action_taken
}
